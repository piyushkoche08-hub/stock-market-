# Environment Configuration for Docker Deployment

# Flask Backend
FLASK_ENV=production
FLASK_APP=app.py
PYTHONUNBUFFERED=1

# Node.js API
NODE_ENV=production
PORT=3001

# Next.js Web
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_NAME=AlphaPulse X

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Optional: External APIs or Services
# YFINANCE_API_KEY=your_key_here
# NEWSAPI_KEY=your_key_here

# Database (if needed in future)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=stock_market
# DB_USER=app_user
# DB_PASSWORD=secure_password

# Server Configuration
WORKERS=4
TIMEOUT=60
