{
  "$schema": "https://json.schemastore.org/vercel",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{client/**,scratch/**,backend/data/cache/**,__pycache__/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
